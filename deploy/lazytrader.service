[Unit]
Description=LazyTrader Unified Fusion Server (Go API + Vite SPA)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/lazytrader/backend
EnvironmentFile=/root/lazytrader/.env
ExecStart=/root/lazytrader/backend/bin/lazytrader
Restart=always
RestartSec=3s
TimeoutStopSec=15s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
