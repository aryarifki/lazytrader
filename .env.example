# Server
APP_HOST=127.0.0.1
APP_PORT=8099
STATIC_DIST_DIR=../frontend/dist
GZIP_MINIMUM_SIZE=1000

# PostgreSQL (Shared bandarmology database — owned by SMtracker pipeline)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bandarmology

# Redis (db0=InvestOwl, db1=Terminal)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_INVESTOWL=0
REDIS_DB_TERMINAL=1

# CORS (comma-separated allowlist, never '*')
CORS_ORIGINS=http://127.0.0.1:8099,http://localhost:5173

# Authentication (Google OAuth2 + HS256 HttpOnly JWT Cookie)
AUTH_SECRET=replace-with-32-byte-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://127.0.0.1:8099
ADMIN_EMAILS=

# Terminal Admin Key (fallback / service-to-service)
TERMINAL_ADMIN_KEY=

# SMtracker Integration (Read-only feature flags + batch CLI runner)
FEATURE_FLAGS_PATH=/root/SMtracker/config/feature_flags.yaml
SMTRACKER_DIR=/root/SMtracker
